# Private key of the account that will deploy and own created rounds.
# Get testnet GEN from the Bradbury faucet before deploying:
# https://bradbury.genlayer.com (or the current testnet faucet URL)
#
# NEVER commit the real .env.deploy file -- it is gitignored by .env*
DEPLOYER_PRIVATE_KEY=0x

# One of: localnet | studionet | testnet-asimov | testnet-bradbury
GENLAYER_NETWORK=testnet-bradbury
